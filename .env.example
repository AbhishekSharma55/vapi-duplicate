# Copy this file to `.env.local` and fill in real values.
# .env.local is gitignored — never commit real keys.

# Deepgram — speech-to-text
# Get a key at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Mistral AI — LLM reply
# Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=

# ElevenLabs — text-to-speech
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: override the default voice (Rachel = 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=
